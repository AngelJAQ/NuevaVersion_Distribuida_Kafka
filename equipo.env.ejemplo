# Plantilla. Copia como 'equipo.env' (o usa equipo.pc1/pc2/pc3.env, que ya vienen listos).
# NODE_ID = orden de PRIORIDAD de relevo: 1 = principal, 2 = primer relevo, 3 = segundo relevo
# MI_IP   = IP de ESTE equipo (si usan Hamachi: la 25.x.x.x de Hamachi)
# IP_PCx  = IP de los 3 equipos (igual en los 3 archivos)
# NO pongas comentarios en la misma línea que un valor.
NODE_ID=1
MI_IP=25.21.176.255

IP_PC1=25.21.176.255
IP_PC2=25.20.239.198
IP_PC3=25.33.81.76

# Roles del nodo de cálculo: suma resta multiplicacion division potencia modulo raiz | todos
NODO_ROLES=todos
